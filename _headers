# Cloudflare Pages static responses. API Function headers must be reviewed separately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Public homepage opener isolation without breaking external sign-in/payment popups.
# The stronger same-origin mode needs a separate cross-app review.
/
  Cross-Origin-Opener-Policy: same-origin-allow-popups
/index.html
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Owner-only static entry: no caching, indexing or outgoing referrer.
/member-operations.html
  Cache-Control: no-store, private
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Cross-Origin-Opener-Policy: same-origin

# Only the noindex Stackbreaker playfield may be embedded by a SAME-ORIGIN
# Deep Cuts page. All other pages keep their default DENY/none policy.
/games/stackbreaker-play/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  X-Robots-Tag: noindex, nofollow
